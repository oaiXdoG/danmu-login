<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oaixdog.loginserver.mapper.GameServerMapper">

    <resultMap id="gameServerResultMap" type="com.oaixdog.loginserver.entity.GameServer">
        <id property="id" column="id"/>
        <result property="serverId" column="server_id"/>
        <result property="serverName" column="server_name"/>
        <result property="serverIp" column="server_ip"/>
        <result property="serverPort" column="server_port"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectFirstOnline" resultMap="gameServerResultMap">
        SELECT id,
               server_id,
               server_name,
               server_ip,
               server_port,
               status,
               created_at,
               updated_at
        FROM game_server
        WHERE status = 'ONLINE'
        ORDER BY id
        LIMIT 1
    </select>

</mapper>
